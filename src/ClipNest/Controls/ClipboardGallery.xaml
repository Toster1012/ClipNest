<UserControl x:Class="ClipNest.Controls.ClipboardGallery" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipNest.Controls">
 <UserControl.Resources>
  <DataTemplate x:Key="LargeCard"><StackPanel><Grid Height="128" Background="#14151F"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/><StackPanel x:Name="FilePreview" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding Glyph}" Foreground="#B4A4ED" FontSize="36" HorizontalAlignment="Center"/><TextBlock Text="{Binding Details}" Foreground="#9D96B1" FontSize="10" Margin="0,8,0,0"/></StackPanel><TextBlock x:Name="TextPreview" Text="{Binding Preview}" Visibility="Collapsed" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#D4CFDF" FontSize="12" Margin="12"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="⧉" Padding="7,4" Background="Transparent" Click="OnCopyEntry" ToolTip="Скопировать выбранное"/></Grid></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding HasThumbnail}" Value="True"><Setter TargetName="FilePreview" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsText}" Value="True"><Setter TargetName="FilePreview" Property="Visibility" Value="Collapsed"/><Setter TargetName="TextPreview" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
  <DataTemplate x:Key="CompactCard"><Grid MinHeight="78"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Border Background="#161620" CornerRadius="8" Margin="0,0,12,0"><Grid><Image Source="{Binding Thumbnail}" Stretch="Uniform"/><TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontSize="25" Foreground="#B9A4ED" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,4,4"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="⧉" Click="OnCopyEntry" Background="Transparent" Padding="4,6" ToolTip="Копировать · Ctrl+C"/><Border Tag="DragHandle" Background="Transparent" Cursor="SizeAll" Padding="4" ToolTip="Перетащить выбранное"><TextBlock Text="⠿" Foreground="#8A809B" FontSize="18" HorizontalAlignment="Center"/></Border></StackPanel></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding HasThumbnail}" Value="True"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#262332" CornerRadius="8" Padding="12,0"><Grid><TextBox x:Name="SearchInput" TextChanged="OnSearchChanged" Height="40" Padding="0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="12"/><TextBlock Text="Поиск в буфере…" Foreground="#91879F" VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=SearchInput}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border><Button Grid.Column="1" Content="Очистить" Click="OnClear" Padding="10,0" Margin="8,0,0,0" FontSize="11" ToolTip="Очистить историю и системный буфер"/></Grid>
  <Grid Grid.Row="1"><ListBox x:Name="EntriesList" Background="Transparent" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged" PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseLeftButtonUp="OnMouseUp" PreviewMouseMove="OnMouseMove" PreviewMouseRightButtonDown="OnContextSelection" PreviewKeyDown="OnKeyDown" LostMouseCapture="OnLostCapture">
   <ListBox.ContextMenu><ContextMenu><MenuItem Header="Копировать выбранное" InputGestureText="Ctrl+C" Click="OnCopy"/><MenuItem Header="Выбрать всё" InputGestureText="Ctrl+A" Click="OnSelectAll"/><Separator/><MenuItem Header="Очистить буфер" Click="OnClear"/><MenuItem Header="Удалить из истории" InputGestureText="Delete" Click="OnRemove"/></ContextMenu></ListBox.ContextMenu>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Width" Value="204"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ToolTip" Value="{Binding Preview}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#22212E" BorderBrush="#363142" BorderThickness="1.5" CornerRadius="11" Padding="9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#BA96FF"/><Setter TargetName="Card" Property="Background" Value="#342A45"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Card" Property="BorderBrush" Value="#6F6087"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardGallery}}}" Value="True"><Setter Property="Width" Value="Auto"/><Setter Property="Margin" Value="0,0,3,9"/></DataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
  </ListBox><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><Image Source="/Assets/Branding/ClipNest.png" Width="64" Height="64" Margin="0,0,0,16"/><TextBlock x:Name="EmptyTitle" Text="Буфер пока пуст" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Скопируйте текст, файл или картинку" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Grid>
  <TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" Foreground="#D0B9F3" FontSize="10" Margin="0,8,0,0" Visibility="Collapsed"/>
 </Grid>
</UserControl>
