<Window x:Class="ClipNest.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ClipNest.Controls" Title="ClipNest" Icon="/Assets/Branding/ClipNest.png" Width="1000" Height="720" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#15151F" Foreground="White" FontFamily="Segoe UI" WindowStyle="None" ResizeMode="CanResize" SourceInitialized="OnSourceInitialized" Closing="OnClosing" KeyDown="OnKeyDown">
 <Border Background="#15151F" BorderBrush="#3C354D" BorderThickness="1" CornerRadius="12" Padding="28,20,28,24">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Background="Transparent" MouseLeftButtonDown="OnTitleMouseDown" Margin="0,0,0,28"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Branding/ClipNest.png" Width="46" Height="46" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="ClipNest" FontSize="21" FontWeight="SemiBold"/></StackPanel></StackPanel><Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnHide" Background="Transparent" ToolTip="Скрыть в трей"/></Grid>
   <Grid Grid.Row="1" Margin="0,0,0,22"><StackPanel Orientation="Horizontal"><Button x:Name="CollectionTab" Content="Коллекция" Click="OnCollection" Background="#3B2E52" Margin="0,0,8,0"/><Button x:Name="SettingsTab" Content="Настройки" Click="OnSettings" Background="Transparent"/></StackPanel><TextBlock Text="КОМПАКТНАЯ ПАНЕЛЬ    WIN + V" FontSize="10" Foreground="#AD91DF" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <controls:ClipboardGallery x:Name="Gallery" Grid.Row="2"/>
   <Grid x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed"><StackPanel Width="360" HorizontalAlignment="Left" Margin="0,12,0,0"><TextBlock Text="Лимит истории" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="CapacityInput" Width="130" HorizontalAlignment="Left"/><TextBlock Text="От 1 до 1000 записей" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,26"/><CheckBox x:Name="StartupInput" Content="Запускать при входе в Windows"/><Button Content="Сохранить" Background="#8860D5" HorizontalAlignment="Left" Click="OnSaveSettings" Margin="0,26,0,0"/><TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Foreground="#C8ACFF" Margin="0,14,0,0"/></StackPanel></Grid>
   <TextBlock x:Name="CaptureStatus" Grid.Row="3" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#868098" FontSize="11" Margin="0,16,0,0"/>
  </Grid>
 </Border>
</Window>
